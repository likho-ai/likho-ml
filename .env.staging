# Committed: no secrets here. Secrets for this environment live in .env.staging.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.staging, .env.staging.local; a real environment variable wins.

LIKHO_ENV=staging
LOG_LEVEL=INFO
GRPC_PORT=5080
HTTP_PORT=4080

# In-cluster names (Kubernetes namespace likho-staging); likho-deploy sets them up.
# DATABASE_URL carries the password: in .env.staging.local
NATS_URL=nats://nats:4222

MIGRATE_ON_START=true

# The models bucket (S3_ACCESS_KEY and S3_SECRET_KEY in .env.staging.local).
S3_ENDPOINT=http://objectstore:8333
S3_REGION=us-east-1
S3_BUCKET_MODELS=likho-models
# Where a training run is handed to (a GPU machine's agent); empty = runs wait as pending.
LAUNCHER_URL=

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
